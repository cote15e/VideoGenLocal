# Скопируйте в .env. Пустые ключи можно не заполнять:
# без них выпуск собирается локальным разбором, edge-tts и Ken Burns.

VIDEGEN_HOST=127.0.0.1
VIDEGEN_PORT=8741
VIDEGEN_DATA_DIR=data

# Языковая модель. Используется, только если в настройках выбран режим API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# Озвучка ElevenLabs (режим API или авто без GPU 12 ГБ).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Голос edge-tts, если Piper не установлен.
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural

# B-roll. Без ключа остаётся Ken Burns, выпуск не блокируется.
RUNWAY_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=

# Локальный Piper. Оба пути нужны, иначе берётся edge-tts.
PIPER_BINARY=
PIPER_MODEL=
